{
  "rules": {
    "cars": {
      "$carId": {
        ".read": "auth != null && (root.child('access/'+$carId+'/'+auth.uid).exists() || !root.child('access/'+$carId).exists())",
        ".write": "auth != null && (root.child('access/'+$carId+'/'+auth.uid).exists() || !root.child('access/'+$carId).exists())",
        "status":      { ".indexOn": ["ts"] },
        "trips":       { ".indexOn": ["start"] },
        "sentryEvents":{ ".indexOn": ["ts"] },
        "commands":    { ".indexOn": ["ts"] },
        "responses":   { ".indexOn": ["ts"] }
      }
    },
    "access": {
      "$carId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "pairing": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["createdAt"],
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "admins": {
      ".read": "auth != null",
      "$uid": { ".write": false }
    },
    "admin": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    }
  }
}
